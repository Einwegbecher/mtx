# Matrix Server Configuration
# ============================

# Domain Configuration
MATRIX_DOMAIN=matrix.yourdomain.com
ELEMENT_DOMAIN=element.yourdomain.com

# Database Configuration
POSTGRES_USER=synapse_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=synapse

# Synapse Configuration
SYNAPSE_SERVER_NAME=matrix.yourdomain.com
SYNAPSE_CONFIG_PATH=/data/homeserver.yaml
SYNAPSE_REPORT_STATS=no

# Element X Configuration
ELEMENT_X_SERVER=https://matrix.yourdomain.com
ELEMENT_X_BASE_URL=https://element.yourdomain.com

# Redis Configuration
REDIS_PASSWORD=your_redis_password_here

# SSL Configuration (set to true if you have SSL certificates)
SSL_ENABLED=false
SSL_CERT_PATH=/nginx/ssl/fullchain.pem
SSL_KEY_PATH=/nginx/ssl/privkey.pem

# Admin User (first user created)
ADMIN_USER=admin
ADMIN_PASSWORD=admin_password
ADMIN_EMAIL=admin@yourdomain.com

# Ports
SYNAPSE_PORT=8008
POSTGRES_PORT=5432
REDIS_PORT=6379
ELEMENT_X_PORT=80
NGINX_PORT=80
NGINX_SSL_PORT=443

# Docker Network
DOCKER_NETWORK=matrix-network

# Resource Limits (adjust based on your server)
SYNAPSE_MEMORY_LIMIT=2g
SYNAPSE_CPU_LIMIT=2.0